# Copy to server/.env and fill in. The server refuses to start with the example keys
# unless ENTOMIRA_MODO_LOCAL=1 (local development only).
ADMIN_USER=entomira
ADMIN_PASS=
DEVICE_API_KEY=change-me-device-key
WORKER_API_KEY=change-me-worker-key
ENTOMIRA_DATA_DIR=./data
ENTOMIRA_ORIGENES=http://localhost:8000
ENTOMIRA_REDES_CAMARAS=192.168.1.0/24
# ENTOMIRA_MODO_LOCAL=1

# Worker
SERVER_BASE_URL=http://127.0.0.1:8000
WORKER_MODEL_PATH=models/best.pt
WORKER_DEVICE=0
